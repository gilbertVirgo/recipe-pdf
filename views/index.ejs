<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Recipe to PDF</title>
		<link rel="stylesheet" href="/main.css" />
	</head>
	<body>
		<h1>Create a new recipe</h1>
		<form method="post" action="/pdf">
			<div>
				<label for="title" class="required">Recipe title:</label>
				<input
					type="text"
					id="title"
					name="title"
					placeholder="Enter recipe name"
					value="Chocolate Cake"
					required
				/>
			</div>

			<div class="form-row">
				<div>
					<label for="portions" class="required"
						>Number of portions:</label
					>
					<input
						type="number"
						id="portions"
						name="portions"
						min="1"
						placeholder="e.g., 4"
						value="8"
						required
					/>
				</div>

				<div>
					<label for="prepTime" class="required"
						>Prep time (minutes):</label
					>
					<input
						type="number"
						id="prepTime"
						name="prepTime"
						min="0"
						placeholder="e.g., 15"
						value="20"
						required
					/>
				</div>

				<div>
					<label for="cookingTime" class="required"
						>Cooking time (minutes):</label
					>
					<input
						type="number"
						id="cookingTime"
						name="cookingTime"
						min="0"
						placeholder="e.g., 30"
						value="45"
						required
					/>
				</div>
			</div>

			<div>
				<label for="ingredients" class="required">Ingredients:</label>
				<textarea
					id="ingredients"
					name="ingredients"
					rows="10"
					placeholder="Enter ingredients, one per line"
					required
				>
2 cups flour
1 cup sugar
1 cup milk
2 eggs
1/2 cup cocoa powder
1 tsp baking powder
1/2 tsp salt</textarea
				>
			</div>

			<div>
				<label for="method" class="required">Method:</label>
				<textarea
					id="method"
					name="method"
					rows="10"
					placeholder="Enter cooking instructions step by step"
					required
				>
1. Preheat the oven to 350°F (175°C).
2. Mix dry ingredients together.
3. Add wet ingredients and mix until smooth.
4. Pour into a greased baking pan.
5. Bake for 45 minutes or until a toothpick comes out clean.</textarea
				>
			</div>

			<div>
				<label for="notes">Notes:</label>
				<textarea
					id="notes"
					name="notes"
					rows="5"
					placeholder="Any additional notes or tips (optional)"
				>
Let the cake cool before serving. Add frosting if desired.</textarea
				>
			</div>

			<div>
				<button type="submit">Download PDF</button>
			</div>
		</form>
	</body>
</html>
